# Copy to `.env` and fill in the values. `.env` is git-ignored: never commit it.

# --- OpenWeather -------------------------------------------------------------
OPENWEATHER_API_KEY=replace-with-your-key
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
OPENWEATHER_TIMEOUT_SECONDS=10
DEFAULT_UNITS=metric
DEFAULT_LANG=pt_br

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=weather
POSTGRES_PASSWORD=change-me
POSTGRES_DB=weather
# SQLAlchemy URL (driver: psycopg 3). Use host `localhost` when running the API outside Docker.
DATABASE_URL=postgresql+psycopg://weather:change-me@localhost:5432/weather
