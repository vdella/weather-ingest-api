# Copy to `.env` and fill in the values. `.env` is git-ignored: never commit it.

# --- OpenWeather -------------------------------------------------------------
OPENWEATHER_API_KEY=replace-with-your-key
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
OPENWEATHER_TIMEOUT_SECONDS=10
DEFAULT_UNITS=metric
DEFAULT_LANG=pt_br
