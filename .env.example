# Copy to `.env` and fill in the values. `.env` is git-ignored: never commit it.

# --- OpenWeather -------------------------------------------------------------
OPENWEATHER_API_KEY=replace-with-your-key
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
OPENWEATHER_TIMEOUT_SECONDS=10
DEFAULT_UNITS=metric
DEFAULT_LANG=pt_br

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=weather
POSTGRES_PASSWORD=change-me
POSTGRES_DB=weather
# Host port for PostgreSQL. Only used with docker-compose.db-port.yml, which publishes
# the database on 127.0.0.1; by default the database is reachable only inside Docker.
POSTGRES_PORT=5432

# SQLAlchemy URL (driver: psycopg 3) used when running the API on the host.
# Docker Compose ignores it and points the API at the `db` service instead.
DATABASE_URL=postgresql+psycopg://weather:change-me@localhost:5432/weather

# --- API ---------------------------------------------------------------------
# Host port for the REST API (Swagger UI at http://localhost:${API_PORT}/docs).
API_PORT=8000
